# Maintainer: mhdztr <zakkithoriq@gmail.com>
pkgname=hyprcam
pkgver=0.1.0
pkgrel=1
pkgdesc="Frameless, tiled webcam window for Hyprland with live settings and OBS-friendly screen capture"
arch=('any')
url="https://github.com/mhdztr/hyprcam"
license=('MIT')
depends=('python' 'pyside6' 'python-opencv')
makedepends=('python-build' 'python-installer' 'python-setuptools')
optdepends=(
  'v4l-utils: detailed camera and FOURCC format discovery'
  'hyprland: keybinding and window-rule integration'
)
source=("https://github.com/mhdztr/hyprcam/archive/refs/tags/v${pkgver}.tar.gz")
# sha256 of the v0.1.0 GitHub source tarball (verified 2026-11-23):
#   curl -fsSL -o hyprcam-v0.1.0.tar.gz https://github.com/mhdztr/hyprcam/archive/refs/tags/v0.1.0.tar.gz
#   sha256sum hyprcam-v0.1.0.tar.gz
sha256sums=('46029482e1d25a541e52bdca167683b5b90d573403e3843e56b4ab1aeb28084c')

build() {
  cd "${srcdir}/hyprcam-${pkgver}"
  python -m build --wheel --no-isolation
}

package() {
  cd "${srcdir}/hyprcam-${pkgver}"
  python -m installer --destdir="${pkgdir}" dist/*.whl
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 config.example.toml "${pkgdir}/usr/share/doc/${pkgname}/config.example.toml"
}

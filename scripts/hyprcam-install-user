#!/bin/sh
# Idempotent user-level installer: symlinks, desktop entry, first-run config.
set -eu

SELF=$(readlink -f "$0")
ROOT=$(CDPATH= cd -- "$(dirname "$SELF")/.." && pwd)

BIN_DIR="$HOME/.local/bin"
APP_DIR="$HOME/.local/share/applications"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hyprcam"
CONFIG_FILE="$CONFIG_DIR/config.toml"

mkdir -p "$BIN_DIR" "$APP_DIR" "$CONFIG_DIR"

ln -sfn "$ROOT/scripts/hyprcam" "$BIN_DIR/hyprcam"
ln -sfn "$ROOT/scripts/hyprcam-toggle" "$BIN_DIR/hyprcam-toggle"
echo "linked $BIN_DIR/hyprcam"
echo "linked $BIN_DIR/hyprcam-toggle"

ln -sfn "$ROOT/hyprcam.desktop" "$APP_DIR/hyprcam.desktop"
echo "installed $APP_DIR/hyprcam.desktop"

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "$APP_DIR" 2>/dev/null || true
fi

if [ -e "$CONFIG_FILE" ]; then
    echo "kept existing $CONFIG_FILE"
else
    cp "$ROOT/config.example.toml" "$CONFIG_FILE"
    echo "seeded $CONFIG_FILE"
fi

case ":${PATH:-}:" in
    *":$BIN_DIR:"*) ;;
    *)
        echo "warning: $BIN_DIR is not on PATH; add it to your shell config and re-login" >&2
        ;;
esac
